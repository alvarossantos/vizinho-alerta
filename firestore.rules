rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminClaim() {
      return request.auth != null
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isAdminRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isAdminClaim() || isAdminRole();
    }

    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow write: if isAdmin();
    }

    match /ocorrencias/{id} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tipo is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.situacao == 'registrado'  // Sempre começa como registrado
        && request.resource.data.status == 'aberto'
        && request.resource.data.createdAt is number;

      // Atualização: AUTHOR pode mudar situacao para resolvido/rejeitado
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['situacao', 'status', 'lat', 'lng'])
        && request.resource.data.situacao in ['registrado', 'resolvido', 'rejeitado']
        && request.resource.data.status in ['aberto', 'resolvido']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90.0 && request.resource.data.lat <= 90.0
        && request.resource.data.lng >= -180.0 && request.resource.data.lng <= 180.0;

      // Atualização ADMIN: ADMIN pode mudar qualquer situacao
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['situacao', 'status', 'lat', 'lng'])
        && request.resource.data.situacao in ['registrado', 'em_verificacao', 'confirmado', 'resolvido', 'rejeitado']
        && request.resource.data.status in ['aberto', 'resolvido']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90.0 && request.resource.data.lat <= 90.0
        && request.resource.data.lng >= -180.0 && request.resource.data.lng <= 180.0;

      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Coleção de filas para moderação (futuro)
    match /moderacao/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
